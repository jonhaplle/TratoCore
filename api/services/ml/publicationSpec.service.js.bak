const apiService = require("./api.service");
const attributeResolver = require("./attributeResolver.service");

const DEFAULT_SITE_ID = process.env.ML_SITE_ID || "MLB";
const DEFAULT_LISTING_TYPE =
    process.env.ML_DEFAULT_LISTING_TYPE || "gold_pro";

function clean(value) {
    if (value === undefined || value === null) return "";
    return String(value).trim();
}

function isLeaf(category) {
    return (
        !Array.isArray(category.children_categories) ||
        category.children_categories.length === 0
    );
}

function findListingType(available, preferred) {
    const list = Array.isArray(available?.available)
        ? available.available
        : [];

    return list.find(item => item.id === preferred) || null;
}

/**
 * Monta somente os dados básicos necessários para consultar
 * os atributos condicionais do Mercado Livre.
 */
function buildConditionalPayload(product, categoryId, listingType, attributes = []) {
    const price = Number(product.sale_price);

    if (!Number.isFinite(price) || price <= 0) {
        throw new Error(
            "Preço inválido para consulta de atributos condicionais."
        );
    }

    const quantity = Math.max(1, Number(product.quantity || 1));

    const condition =
        String(product.condition || "used").toLowerCase() === "new"
            ? "new"
            : "used";

    const payload = {
        title: clean(product.title),
        category_id: categoryId,
        price,
        currency_id: "BRL",
        available_quantity: quantity,
        buying_mode: "buy_it_now",
        condition,
        listing_type_id: listingType.id,
        description: {
            plain_text: clean(product.description || product.title)
        }
    };

    /**
     * O endpoint condicional pode usar atributos já conhecidos
     * para determinar quais outros atributos são necessários.
     *
     * IMPORTANTE:
     * Só enviamos atributos efetivamente resolvidos.
     */
    if (Array.isArray(attributes) && attributes.length > 0) {
        payload.attributes = attributes.filter(
            attribute =>
                attribute &&
                clean(attribute.id) &&
                (
                    clean(attribute.value_id) ||
                    clean(attribute.value_name)
                )
        );
    }

    return payload;
}

exports.resolve = async (product) => {
    const title = clean(product.title);

    if (!title) {
        throw new Error("Produto sem título para categorização.");
    }

    /*
     * ============================================================
     * 1. CATEGORIZAÇÃO
     * ============================================================
     */

    const predictions = await apiService.predictCategory(title);

    let prediction = null;
    let category = null;

    for (const candidate of predictions) {
        if (!candidate?.category_id) continue;

        const candidateCategory = await apiService.getCategory(
            candidate.category_id
        );

        if (isLeaf(candidateCategory)) {
            prediction = candidate;
            category = candidateCategory;
            break;
        }
    }

    if (!prediction || !category) {
        throw new Error(
            "O preditor do Mercado Livre não retornou uma categoria folha utilizável."
        );
    }

    /*
     * ============================================================
     * 2. ATRIBUTOS DA CATEGORIA
     * ============================================================
     */

    const attributes = await apiService.getCategoryAttributes(
        category.id
    );

    /*
     * ============================================================
     * 3. LISTING TYPE
     * ============================================================
     */

    const me = await apiService.getMe();

    const availableListingTypes =
        await apiService.getAvailableListingTypes(
            me.id,
            category.id
        );

    const preferredListingType =
        product.ml_listing_type || DEFAULT_LISTING_TYPE;

    const listingType = findListingType(
        availableListingTypes,
        preferredListingType
    );

    if (!listingType) {
        const available = (availableListingTypes.available || [])
            .map(item => item.id)
            .join(", ") || "nenhum";

        throw new Error(
            `O listing_type '${preferredListingType}' não está disponível para ` +
            `${category.id}. Disponíveis: ${available}. ` +
            "Por regra do TratoCore, não fazer downgrade automático."
        );
    }

    /*
     * ============================================================
     * 4. RESOLUÇÃO PRELIMINAR
     * ============================================================
     *
     * Aqui NÃO usamos conditionalAttributes.
     *
     * O objetivo dessa etapa é apenas descobrir aquilo que já
     * conseguimos obter do produto:
     *
     * - marca
     * - modelo
     * - material
     * - cor
     * - artista
     * - etc.
     *
     * O campo "missing" dessa etapa NÃO decide a publicação.
     */

    const preliminary = attributeResolver.build({
        product,
        categoryAttributes: attributes,
        conditionalAttributes: [],
        prediction
    });

    /*
     * ============================================================
     * 5. CONSULTA AO ENDPOINT CONDITIONAL DO ML
     * ============================================================
     */

    const conditionalPayload = buildConditionalPayload(
        product,
        category.id,
        listingType,
        preliminary.attributes
    );

    console.log("========== CONSULTA CONDITIONAL ML ==========");
    console.log("Categoria:", category.id);
    console.log("Título:", conditionalPayload.title);
    console.log(
        "Atributos enviados:",
        JSON.stringify(conditionalPayload.attributes || [], null, 2)
    );
    console.log("=============================================");

    const conditionalAttributes =
        await apiService.getConditionalAttributes(
            category.id,
            conditionalPayload
        );

    /*
     * ============================================================
     * 6. DIAGNÓSTICO DA RESPOSTA DO MERCADO LIVRE
     * ============================================================
     */

    console.log("========== RESPOSTA CONDITIONAL ML ==========");
    console.log(
        JSON.stringify(conditionalAttributes, null, 2)
    );
    console.log("=============================================");

    /*
     * ============================================================
     * 7. RETORNO DA FICHA
     * ============================================================
     *
     * A decisão final sobre "missing" será feita pelo item.service.js,
     * que executará novamente o attributeResolver usando os
     * required_attributes retornados pelo Mercado Livre.
     */

    return {
        site_id: DEFAULT_SITE_ID,
        prediction,
        predictions,
        category,
        attributes,
        conditionalAttributes,
        conditionalPayload,
        listing_type: listingType,
        category_id: category.id
    };
};