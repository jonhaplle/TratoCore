const axios = require("axios");`nconst pool = require("../../db");`nconst tokenService = require("./token.service");`n`nconst API = "https://api.mercadolibre.com";`n`nlet accessToken = null;`n`nexports.setAccessToken = (token) => {`n    accessToken = token;`n};`n`nexports.getAccessToken = async () => {`n    if (accessToken) return accessToken;`n`n    const result = await pool.query("SELECT access_token FROM ml_tokens ORDER BY created_at DESC LIMIT 1");`n`n    if (!result.rows.length) throw new Error("Access Token nao configurado.");`n`n    accessToken = result.rows[0].access_token;`n    return accessToken;`n};`n`nasync function request(config, retry = true) {`n    try {`n        const token = await exports.getAccessToken();`n`n        config.headers = {`n            ...(config.headers || {}),`n            Authorization: `Bearer $($token)`,`n            "User-Agent": "TratoCore/1.0"`n        };`n`n        return await axios(config);`n    } catch (err) {`n        if (retry && err.response && err.response.status === 401) {`n            console.log("ACCESS TOKEN EXPIRADO - RENOVANDO...");`n            accessToken = await tokenService.refresh();`n            return request(config, false);`n        }`n        throw err;`n    }`n}`n`nexports.publishItem = async (item) => {`n    const response = await request({`n        method: "post",`n        url: `${API}/items`,`n        data: item,`n        headers: {`n            "Content-Type": "application/json"`n        },`n        timeout: 30000`n    });`n    return response.data;`n};`n`nexports.createDescription = async (itemId, description) => {`n    const response = await request({`n        method: "post",`n        url: `${API}/items/${itemId}/description`,`n        data: { plain_text: description },`n        headers: { "Content-Type": "application/json" },`n        timeout: 30000`n    });`n    return response.data;`n};`n`nexports.getItem = async (itemId) => {`n    const response = await request({`n        method: "get",`n        url: `${API}/items/${itemId}`,`n        timeout: 30000`n    });`n    return response.data;`n};`n`nexports.getMe = async () => {`n    const response = await request({`n        method: "get",`n        url: `${API}/users/me`,`n        timeout: 30000`n    });`n    return response.data;`n};`n`nexports.updateItem = async (itemId, body) => {`n    const response = await request({`n        method: "put",`n        url: `${API}/items/${itemId}`,`n        data: body,`n        headers: { "Content-Type": "application/json" },`n        timeout: 30000`n    });`n    return response.data;`n};`n`nexports.predictCategory = async (title) => {`n    if (!title || !String(title).trim()) throw new Error("Titulo nao informado para previsao de categoria.");`n    const response = await request({`n        method: "get",`n        url: `${API}/sites/MLB/domain_discovery/search`,`n        params: { limit: 3, q: String(title).trim() },`n        timeout: 30000`n    });`n    return response.data;`n};`n`nexports.searchProducts = async (params = {}) => {`n    const response = await request({`n        method: "get",`n        url: `${API}/products/search`,`n        params: { site_id: "MLB", status: "active", ...params },`n        timeout: 30000`n    });`n    return response.data;`n};`n`nexports.getProduct = async (productId) => {`n    if (!productId) throw new Error("Product ID nao informado.");`n    const response = await request({`n        method: "get",`n        url: `${API}/products/${encodeURIComponent(productId)}`,`n        timeout: 30000`n    });`n    return response.data;`n};