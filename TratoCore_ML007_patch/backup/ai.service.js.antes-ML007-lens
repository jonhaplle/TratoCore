        if (tamanhoPolegadas !== null) {
            resultado.technical_attributes =
                resultado.technical_attributes &&
                typeof resultado.technical_attributes === "object"
                    ? resultado.technical_attributes
                    : {};

            if (!resultado.technical_attributes.tamanho_polegadas) {
                resultado.technical_attributes.tamanho_polegadas = tamanhoPolegadas;
            }

            const medidaTexto = Number.isInteger(tamanhoPolegadas)
                ? String(tamanhoPolegadas)
                : String(tamanhoPolegadas).replace('.', ',');

            const tituloAtual = String(resultado.title || "").trim();
            if (tituloAtual && !/\b\d{1,3}(?:[.,]\d+)?\s*(?:pol(?:\.|egadas?)?|polegadas?)\b/i.test(tituloAtual)) {
                resultado.title = tituloAtual.replace(/\s+$/,'') + " " + medidaTexto + " Polegadas";
            }

            const descricaoAtual = String(resultado.description || "").trim();
            if (!new RegExp("\\b" + medidaTexto.replace('.', '[.,]') + "\\s*(?:pol|polegadas?)\\b", "i").test(descricaoAtual)) {
                resultado.description = (descricaoAtual ? descricaoAtual + " " : "") +
                    "Tamanho informado pelo vendedor: " + medidaTexto + " polegadas.";
            }
        }

        return {

            product_type: resultado.product_type || "",
            brand: resultado.brand || "",
            line: resultado.line || "",
            model: resultado.model || "",
            generation: resultado.generation || "",
            version: resultado.version || "",
            color: resultado.color || "",

            condition:
                String(resultado.condition || "used").toLowerCase() === "new"
                    ? "new"
