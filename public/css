/* ==========================================================
   TRATO CORE 0.5
   style.css
========================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:"Segoe UI",Tahoma,Geneva,Verdana,sans-serif;

    background:#eef2f7;

    color:#333;

}

.container{

    width:95%;

    max-width:1400px;

    margin:30px auto;

}

/* ==========================================================
   HEADER
========================================================== */

header{

    margin-bottom:30px;

}

header h1{

    font-size:42px;

    color:#1f2937;

    margin-bottom:8px;

}

header p{

    color:#666;

    font-size:18px;

}

/* ==========================================================
   LAYOUT
========================================================== */

.content{

    display:grid;

    grid-template-columns:360px 1fr;

    gap:25px;

}

/* ==========================================================
   PAINÉIS
========================================================== */

.photo-panel,
.form-panel{

    background:#ffffff;

    border-radius:12px;

    padding:20px;

    box-shadow:0 4px 12px rgba(0,0,0,.08);

}

/* ==========================================================
   PREVIEW
========================================================== */

.preview{

    width:100%;

    height:380px;

    border:2px dashed #cbd5e1;

    border-radius:10px;

    display:flex;

    align-items:center;

    justify-content:center;

    background:#fafafa;

    overflow:hidden;

    margin-bottom:20px;

    color:#777;

    font-size:18px;

}

.preview img{

    width:100%;

    height:100%;

    object-fit:contain;

}

/* ==========================================================
   INPUT FILE
========================================================== */

input[type=file]{

    width:100%;

    margin-bottom:20px;

}

/* ==========================================================
   FORMULÁRIO
========================================================== */

.row{

    display:flex;

    gap:18px;

    margin-bottom:18px;

}

.field{

    flex:1;

    display:flex;

    flex-direction:column;

}

.field label{

    margin-bottom:6px;

    font-weight:600;

    color:#444;

}

input,
textarea{

    width:100%;

    padding:12px;

    border:1px solid #cfd8e3;

    border-radius:8px;

    font-size:15px;

    transition:.2s;

}

input:focus,
textarea:focus{

    outline:none;

    border-color:#2563eb;

    box-shadow:0 0 0 3px rgba(37,99,235,.15);

}

textarea{

    min-height:180px;

    resize:vertical;

}

/* ==========================================================
   BOTÕES
========================================================== */

button{

    border:none;

    border-radius:8px;

    cursor:pointer;

    transition:.2s;

    font-size:15px;

    font-weight:600;

}

#btnAnalyze{

    width:100%;

    padding:14px;

    background:#2563eb;

    color:#fff;

    margin-bottom:20px;

}

#btnAnalyze:hover{

    background:#1d4ed8;

}

.buttons{

    display:flex;

    gap:15px;

    margin-top:20px;

}

#btnSave{

    flex:1;

    padding:14px;

    background:#16a34a;

    color:white;

}

#btnSave:hover{

    background:#15803d;

}

#btnNew{

    flex:1;

    padding:14px;

    background:#6b7280;

    color:white;

}

#btnNew:hover{

    background:#4b5563;

}

/* ==========================================================
   RESPONSIVO
========================================================== */

@media (max-width:900px){

    .content{

        grid-template-columns:1fr;

    }

    .row{

        flex-direction:column;

    }

}