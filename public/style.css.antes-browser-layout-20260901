/* ==========================================================
   TRATO CORE 0.5
   style.css
========================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:"Segoe UI",Tahoma,Geneva,Verdana,sans-serif;
    background:#eef2f7;
    color:#333;
}

.container{
    width:95%;
    max-width:1400px;
    margin:30px auto;
}

header{
    margin-bottom:25px;
}

header.topo{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    padding:18px 24px;
    background:#111827;
    color:#fff;
    border-radius:12px;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
}

header.topo h1{
    color:#fff;
    margin:0;
}

header.topo p{
    color:#cbd5e1;
    margin-top:6px;
}

header.topo nav{
    display:flex;
    gap:8px;
}

header.topo nav a{
    color:#cbd5e1;
    text-decoration:none;
    padding:9px 14px;
    border-radius:8px;
    font-size:14px;
}

header.topo nav a:hover{
    background:rgba(255,255,255,.08);
    color:#fff;
}

header.topo nav a.ativo{
    background:#fff;
    color:#111827;
}

header h1{
    font-size:42px;
    color:#1f2937;
}

header p{
    margin-top:8px;
    color:#666;
    font-size:18px;
}

.content{
    display:grid;
    grid-template-columns:360px 1fr;
    gap:25px;
}

.photo-panel,
.form-panel{
    background:#fff;
    border-radius:12px;
    padding:20px;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.preview{
    width:100%;
    height:380px;
    border:2px dashed #cbd5e1;
    border-radius:10px;
    background:#fafafa;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
    margin-bottom:20px;
    color:#888;
    font-size:18px;
}

.preview img{
    width:100%;
    height:100%;
    object-fit:contain;
}

input[type=file]{
    width:100%;
    margin-bottom:20px;
}

.row{
    display:flex;
    gap:20px;
    margin-bottom:18px;
}

.field{
    flex:1;
    display:flex;
    flex-direction:column;
}

.field label{
    margin-bottom:6px;
    font-weight:600;
    color:#444;
}

input,
textarea{
    width:100%;
    padding:12px;
    border:1px solid #d0d7de;
    border-radius:8px;
    font-size:15px;
    transition:.2s;
}

input:focus,
textarea:focus{
    outline:none;
    border-color:#2563eb;
    box-shadow:0 0 0 3px rgba(37,99,235,.15);
}

textarea{
    resize:vertical;
    min-height:180px;
}

button{
    cursor:pointer;
    border:none;
    border-radius:8px;
    transition:.2s;
    font-size:15px;
    font-weight:600;
}

#btnAnalyze{
    width:100%;
    padding:14px;
    background:#2563eb;
    color:#fff;
    margin-bottom:20px;
}

#btnAnalyze:hover{
    background:#1d4ed8;
}

.buttons{
    display:flex;
    gap:15px;
    margin-top:20px;
}

#btnSave{
    flex:1;
    padding:14px;
    background:#16a34a;
    color:#fff;
}

#btnSave:hover{
    background:#15803d;
}

#btnNew{
    flex:1;
    padding:14px;
    background:#6b7280;
    color:#fff;
}

#btnNew:hover{
    background:#4b5563;
}

@media (max-width:900px){

    .content{
        grid-template-columns:1fr;
    }

    .row{
        flex-direction:column;
        gap:15px;
    }

}

@media (max-width: 700px){
    header.topo{
        flex-direction:column;
        align-items:flex-start;
    }

    header.topo nav{
        width:100%;
    }
}


/* ======================================================
   BROWSER ENGINE — TRATOCORE
   ====================================================== */
.browser-panel {
    grid-column: 1 / -1;
    margin: 0 0 24px;
    padding: 20px;
    border: 1px solid #d9dee8;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 4px 18px rgba(0,0,0,.05);
}
.browser-panel-head { display:flex; justify-content:space-between; gap:20px; align-items:flex-start; }
.browser-panel h2 { margin:0 0 6px; }
.browser-panel p { margin:0; color:#666; font-size:13px; }
.browser-status { padding:6px 10px; border-radius:999px; background:#eee; font-size:12px; white-space:nowrap; }
.browser-controls { display:flex; gap:10px; margin-top:16px; }
.browser-controls input { flex:1; min-width:0; }
.browser-actions { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
.browser-result { margin:14px 0 0; max-height:260px; overflow:auto; padding:12px; background:#111827; color:#e5e7eb; border-radius:8px; font-size:12px; white-space:pre-wrap; }
